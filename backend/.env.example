# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── MongoDB Configuration (REQUIRED) ───────────────────────────
# Get this from your MongoDB Atlas Cloud or Local MongoDB instance
MONGO_URI=mongodb+srv://<username>:<password>@cluster0...mongodb.net/nexusai?retryWrites=true&w=majority

# ─── Authentication Configuration (REQUIRED) ─────────────────────
# Generate a secure random string (e.g. using `openssl rand -base64 32`)
JWT_SECRET=your_jwt_secret_here (Optional now, used for some legacy parts or encryption)

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="your-private-key-with-newlines"
# ─── OpenAI AI Configuration (REQUIRED) ──────────────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── Local AI (Optional — Ollama fallback) ────────────────────────
# Only needed if you want to use a local Ollama model (e.g. llama3)
LOCAL_AI_URL=http://localhost:11434/api/generate
# ─── Email Configuration (Magic Link) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="NexusAI" <noreply@nexusai.com>
# ─── Email Configuration (Magic Link) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="NexusAI" <noreply@nexusai.com>
